# Mobile app environment (Expo public vars are inlined at build time).

# Backend API base URL. REQUIRED for native / EAS production builds.
#   - Expo dev against a real server:   http://<your-LAN-ip>:8080
#   - Staging / production native build: https://api.yourdomain.com
EXPO_PUBLIC_API_BASE_URL=https://api.yourdomain.com

# Replit preview only: the run command injects EXPO_PUBLIC_DOMAIN automatically.
# It is used as a fallback when EXPO_PUBLIC_API_BASE_URL is not set. Do NOT rely
# on it for a distributed build.
# EXPO_PUBLIC_DOMAIN=

# Clerk publishable key (optional — enables Clerk sign-in alongside phone OTP).
# EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
